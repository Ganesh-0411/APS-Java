class Solution {
    public boolean isSameTree(TreeNode p, TreeNode q) {
        if (p == null && q == null) {
            return true;
        }

        // if one node is null
        if (p == null || q == null) {
            return false;
        }

        // if values are different
        if (p.val != q.val) {
            return false;
        }

        // check left and right subtree
        return isSameTree(p.left, q.left) && isSameTree(p.right, q.right);
    }
}
